class Student:
    def __init__(self, name, marks):
     
        self.name = name
        self.marks = marks

    def display(self):
        print(f"Name: {self.name}, Marks: {self.marks}")

name_input = input("Enter student name: ")
marks_input = float(input("Enter marks: "))

s = Student(name_input, marks_input)
s.display()

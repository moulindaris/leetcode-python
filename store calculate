purchase_amount = float(input("Enter total purchase amount : "))
if purchase_amount >= 5000:
    discount_percent = 20
elif purchase_amount >= 3000:
    discount_percent = 10
else:
    discount_percent = 0
discount_amount = (discount_percent / 100) * purchase_amount
final_bill = purchase_amount - discount_amount
print(f"Original Amount: {purchase_amount:.2f}")
print(f"Discount Applied: {discount_percent}% ({discount_amount:.2f})")
print(f"Final Bill Amount: {final_bill:.2f}")

def get_total_seconds(ts):
    date_part, time_part = ts.split()
    d, m, y = map(int, date_part.split('-'))
    h, mi, s = map(int, time_part.split(':'))

    days = (y - 1) * 365 + (y - 1) // 4 - (y - 1) // 100 + (y - 1) // 400

    month_days = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if (y % 4 == 0 and y % 100 != 0) or (y % 400 == 0):
        month_days[2] = 29

    for i in range(1, m):
        days += month_days[i]

    days += (d - 1)

    return days * 86400 + h * 3600 + mi * 60 + s

ts1 = input().strip()
ts2 = input().strip()

diff = get_total_seconds(ts1) - get_total_seconds(ts2)
if diff < 0:
    diff = -diff

print(diff)
